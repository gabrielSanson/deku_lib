# Copy to .env for local development. Never commit real values.
# The web app and the worker read the same variables.

# Session or direct Postgres connection (NOT the transaction pooler: pg-boss needs session features).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Integration tests create and drop this database.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/burger_test

# Supabase project (local values come from `pnpm exec supabase status`).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by `pnpm seed` and by the owner's "add staff" screen.
# Never expose it to the browser: no PUBLIC_ prefix, never in client code.
SUPABASE_SERVICE_ROLE_KEY=

SHOP_NAME=Deku Burger
SHOP_TIMEZONE=America/Sao_Paulo
# Public https URL of the app. Needed at build time only when not served over https.
ORIGIN=

# Directus CMS. Leave empty to use the built-in demo menu.
DIRECTUS_URL=
# Static token of the read-only storefront user printed by `pnpm cms:bootstrap`.
DIRECTUS_TOKEN=
# Shared with the Directus Flow that clears the menu cache (min 16 chars).
CMS_WEBHOOK_SECRET=

# Online payments: none (default, online checkout disabled) or local_stub (development only;
# refused when NODE_ENV=production).
PAYMENT_PROVIDER=none

# iFood stays off until merchant access, credentials and homologation are in place.
IFOOD_ENABLED=false
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
# IFOOD_API_BASE=https://merchant-api.ifood.com.br

# Used by `pnpm seed` for the four demo staff accounts. Required when NODE_ENV=production.
SEED_PASSWORD=
